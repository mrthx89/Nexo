<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPolytronAc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_iot_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- AC Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAcIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/iot_ac_title"
            android:src="@drawable/ic_ac_24"
            app:tint="@color/nexo_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAcTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:text="@string/iot_ac_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvAcSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="@string/iot_ac_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAcPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp" />
    </LinearLayout>

    <!-- Auth Warning / Pairing Banner (Shown when not authenticated) -->
    <LinearLayout
        android:id="@+id/layoutAcAuthWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#241B0D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bolt_24"
            app:tint="@color/nexo_amber" />

        <TextView
            android:id="@+id/tvAcAuthStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="Perlu WhatsApp OTP untuk menghubungkan akun Fira IoT."
            android:textColor="@color/nexo_amber"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcAuthLogin"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/nexo_amber"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="36dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Hubungkan"
            android:textColor="#000000"
            android:textSize="11sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <!-- Telemetry Meter Row (Power, Room Temp, Energy) with Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#121A26"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt_24"
                app:tint="@color/nexo_cyan" />

            <TextView
                android:id="@+id/tvAcPowerWatt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/iot_ac_power_watt"
                android:textColor="@color/nexo_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#243346" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_thermostat_24"
                app:tint="@color/nexo_emerald" />

            <TextView
                android:id="@+id/tvAcRoomTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/iot_ac_room_temp"
                android:textColor="@color/nexo_emerald"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#243346" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chart_energy_24"
                app:tint="@color/nexo_amber" />

            <TextView
                android:id="@+id/tvAcEnergy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/iot_ac_energy"
                android:textColor="@color/nexo_amber"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Temperature Controller Stepper Row with Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcTempDown"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:contentDescription="Turunkan Suhu"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_minus_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="#3A4D66" />

        <TextView
            android:id="@+id/tvAcTargetTemp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="@string/iot_ac_target_temp"
            android:textColor="@color/nexo_cyan"
            android:textSize="26sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcTempUp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:contentDescription="Naikkan Suhu"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_plus_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="#3A4D66" />
    </LinearLayout>

    <!-- Operation Modes Chips with Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcModeCool"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#0E2333"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/iot_ac_mode_cool"
            android:textColor="@color/nexo_cyan"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_snowflake_24"
            app:iconGravity="textStart"
            app:iconPadding="3dp"
            app:iconSize="14dp"
            app:iconTint="@color/nexo_cyan"
            app:strokeColor="@color/nexo_cyan"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcModeDry"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#141E2B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/iot_ac_mode_dry"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_water_drop_24"
            app:iconGravity="textStart"
            app:iconPadding="3dp"
            app:iconSize="14dp"
            app:iconTint="@color/text_secondary"
            app:strokeColor="#2E3C4E"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcModeFan"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#141E2B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/iot_ac_mode_fan"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_fan_24"
            app:iconGravity="textStart"
            app:iconPadding="3dp"
            app:iconSize="14dp"
            app:iconTint="@color/text_secondary"
            app:strokeColor="#2E3C4E"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcModeAuto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:backgroundTint="#141E2B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/iot_ac_mode_auto"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_auto_mode_24"
            app:iconGravity="textStart"
            app:iconPadding="3dp"
            app:iconSize="14dp"
            app:iconTint="@color/text_secondary"
            app:strokeColor="#2E3C4E"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Fan Speed & Swing Row with Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcFanSpeed"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:text="@string/iot_ac_fan_auto"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_fan_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="#2E3C4E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcSwingToggle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="42dp"
            android:text="@string/iot_ac_swing"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_swing_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="#2E3C4E" />
    </LinearLayout>
</LinearLayout>